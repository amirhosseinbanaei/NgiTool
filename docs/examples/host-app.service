# How a project running directly on the host (no Docker) joins NgiTool's edge stack.
# /etc/systemd/system/myapp.service
#
#   systemctl enable --now myapp
#   ufw allow in on br-edge to any port 3001 proto tcp   # let the nginx container in
#   ngitool route add myapp.example.com --to port:3001
#
# `ngitool edge status` shows the network's gateway IP; `route add` prints the
# exact firewall line for your setup (RP-06).

[Unit]
Description=myapp
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=deploy
WorkingDirectory=/home/deploy/myapp
# Bind to the nginx network's gateway IP: reachable from nginx, not from the internet.
Environment=HOST=172.30.0.1
Environment=PORT=3001
ExecStart=/usr/bin/node server.js
Restart=on-failure

[Install]
WantedBy=multi-user.target
