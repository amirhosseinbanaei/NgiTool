# Written by `edge init`; safe to edit by hand.

# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=

# Public ports nginx binds on the host.
HTTP_PORT=80
HTTPS_PORT=443

# Docker network nginx shares with app containers (created or picked by `edge init`).
# Host processes are reached at this network's gateway IP.
EDGE_NETWORK=edge

# This server's public IPv4 — the CLI points Cloudflare DNS records here.
SERVER_IP=

# Seconds certbot waits for Cloudflare DNS to propagate during DNS-01.
CF_PROPAGATION_SECONDS=30
