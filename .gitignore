.env
secrets/*
!secrets/*.example
data/letsencrypt/*
!data/letsencrypt/.gitkeep
data/certs/*
!data/certs/.gitkeep

# Local state — generated by `edge` for this machine, never published
edge.json
conf/sites/*
!conf/sites/00-default.conf
conf/locations/*
!conf/locations/.gitkeep
conf/snippets/ssl/*
!conf/snippets/ssl/.gitkeep
conf/certs/*
!conf/certs/.gitkeep
apps/*
!apps/.gitkeep
www/*
!www/.gitkeep

# Local tooling
.claude/
