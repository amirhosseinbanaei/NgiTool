# Cloudflare API token for certbot DNS-01.
# Create at: Cloudflare dashboard → My Profile → API Tokens → Create Token
#   Template "Edit zone DNS"  →  Permissions: Zone / DNS / Edit
#   Zone Resources: Include → Specific zone → your domain(s)
# Copy to secrets/cloudflare.ini and chmod 600. Never commit the real file.
dns_cloudflare_api_token = PASTE_TOKEN_HERE
