# Cloudflare API token for certbot DNS-01 and NgiTool's DNS records.
# Create at: Cloudflare dashboard → My Profile → API Tokens → Create Token
#   Template "Edit zone DNS"  →  Permissions: Zone / DNS / Edit
#   (+ Zone / SSL and Certificates / Edit for Cloudflare Origin CA certificates)
#   Zone Resources: Include → Specific zone → your domain(s)
# `ngitool edge init` writes secrets/cloudflare.ini (0600). Never commit the real file.
dns_cloudflare_api_token = PASTE_TOKEN_HERE
