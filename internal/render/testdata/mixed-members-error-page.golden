=== /etc/nginx/conf.d/ngitool.conf
# Managed by NgiTool — generated from state; edit with ngitool, changes here are overwritten
# ngitool: instance sha256:1c9dcf7ef26023b2d49e1b16df7bfd494da7f3d4bf49f5682d95c6d4f5624765
# front: the one file its config includes; everything NgiTool serves hangs off it.

# Upgrade only when the client asks for it, "" otherwise so upstream keepalive works (LB-06, RP-08).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

include /etc/nginx/conf.d/ngitool/upstreams/*.conf;
include /etc/nginx/conf.d/ngitool/servers/*.conf;

=== /etc/nginx/conf.d/ngitool/proxy.conf
# Managed by NgiTool — generated from state; edit with ngitool, changes here are overwritten
# ngitool: snippet sha256:4f02f40b3125f4bef3ba89c19f1cd73ba11a79bae57bf195fb696d57dfc806cb
# Included by every proxied location NgiTool writes.
proxy_http_version 1.1;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;
# Room for large response headers. Next.js, Nuxt, SvelteKit and Remix send preload Link
# headers, auth cookies and framework headers that overflow nginx's 4k default, which
# fails the request with 502 "upstream sent too big header" (RP-09).
proxy_buffer_size       16k;
proxy_buffers           8 16k;
proxy_busy_buffers_size 32k;

=== /etc/nginx/conf.d/ngitool/servers/mix.example.com.conf
# Managed by NgiTool — generated from state; edit with ngitool, changes here are overwritten
# ngitool: route:mix.example.com sha256:753e21b54135394c9bbca4d8d2b8dea49f2e922b227e56b1581cb3c074cc70e7
# mix.example.com → web-1:3000, host:9000, 10.0.0.7:8080 (backup) · least connections

server {
    listen 80;
    server_name mix.example.com;
    absolute_redirect off;
    include /etc/nginx/conf.d/ngitool/locations/mix.example.com/*.conf;

    location / {
        proxy_pass http://ngt_mix;
        include /etc/nginx/conf.d/ngitool/proxy.conf;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 3;
        proxy_next_upstream_timeout 15s;
        error_page 502 503 504 /maintenance.html;  # every member down (LB-11)
    }
}

=== /etc/nginx/conf.d/ngitool/upstreams/mix.conf
# Managed by NgiTool — generated from state; edit with ngitool, changes here are overwritten
# ngitool: pool:mix sha256:d3a15ca6f24c8a5dabf56cc1953fac4210f74fa7a35e7ed618acb183f52f9550
# pool mix: web-1:3000, host:9000, 10.0.0.7:8080 (backup) · least connections
upstream ngt_mix {
    zone ngt_mix 64k;
    least_conn;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server web-1:3000 resolve;
    server 172.20.0.1:9000 weight=2;
    server 10.0.0.7:8080 backup;
}

