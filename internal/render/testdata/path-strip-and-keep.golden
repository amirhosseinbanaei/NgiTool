=== /etc/nginx/conf.d/ngitool.conf
# Managed by NgiTool — generated from state; edit with ngitool, changes here are overwritten
# ngitool: instance sha256:1c9dcf7ef26023b2d49e1b16df7bfd494da7f3d4bf49f5682d95c6d4f5624765
# front: the one file its config includes; everything NgiTool serves hangs off it.

# Upgrade only when the client asks for it, "" otherwise so upstream keepalive works (LB-06, RP-08).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

include /etc/nginx/conf.d/ngitool/upstreams/*.conf;
include /etc/nginx/conf.d/ngitool/servers/*.conf;

=== /etc/nginx/conf.d/ngitool/locations/app.example.com/admin.conf
# Managed by NgiTool — generated from state; edit with ngitool, changes here are overwritten
# ngitool: route:app.example.com/admin sha256:c7a0a3e0c21e923d659d793c44c06e0e50cacf37b3daa726c507bc0f01dc5a3a
location = /admin { return 301 /admin/$is_args$args; }

location /admin/ {
    proxy_pass http://ngt_admin;
    include /etc/nginx/conf.d/ngitool/proxy.conf;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Forwarded-Prefix /admin;
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
}

=== /etc/nginx/conf.d/ngitool/locations/app.example.com/api.conf
# Managed by NgiTool — generated from state; edit with ngitool, changes here are overwritten
# ngitool: route:app.example.com/api sha256:615bdb5f7c83fbb9262bd5653db54be667645797d8857b22026ed7190cc90e3f
location = /api { return 301 /api/$is_args$args; }

location /api/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://ngt_api;
    include /etc/nginx/conf.d/ngitool/proxy.conf;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Forwarded-Prefix /api;
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
}

=== /etc/nginx/conf.d/ngitool/proxy.conf
# Managed by NgiTool — generated from state; edit with ngitool, changes here are overwritten
# ngitool: snippet sha256:4f02f40b3125f4bef3ba89c19f1cd73ba11a79bae57bf195fb696d57dfc806cb
# Included by every proxied location NgiTool writes.
proxy_http_version 1.1;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;
# Room for large response headers. Next.js, Nuxt, SvelteKit and Remix send preload Link
# headers, auth cookies and framework headers that overflow nginx's 4k default, which
# fails the request with 502 "upstream sent too big header" (RP-09).
proxy_buffer_size       16k;
proxy_buffers           8 16k;
proxy_busy_buffers_size 32k;

=== /etc/nginx/conf.d/ngitool/servers/app.example.com.conf
# Managed by NgiTool — generated from state; edit with ngitool, changes here are overwritten
# ngitool: route:app.example.com sha256:f8c6fc8a17d990e255ac6c6f4fa5f63c8359c3541e9d5c7164af72fabe3e24f0
# app.example.com → paths only

server {
    listen 80;
    server_name app.example.com;
    absolute_redirect off;
    include /etc/nginx/conf.d/ngitool/locations/app.example.com/*.conf;

    location / { return 404; }
}

=== /etc/nginx/conf.d/ngitool/upstreams/admin.conf
# Managed by NgiTool — generated from state; edit with ngitool, changes here are overwritten
# ngitool: pool:admin sha256:28ca57a7592ef7a323517cf78c63af7dcffa5b25066f4caf0d4d542f6c221dfa
# pool admin: web-2:8080
upstream ngt_admin {
    zone ngt_admin 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server web-2:8080 resolve;
}

